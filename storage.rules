rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMember(coupleId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }

    // Everything for a couple lives under couples/{coupleId}/...
    match /couples/{coupleId}/{allPaths=**} {
      allow read: if isMember(coupleId);
      allow create, update: if isMember(coupleId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isMember(coupleId);
    }
  }
}
